{
	"name": "arbitrum-litro-workspace",
	"version": "0.3.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.24.0",
	"scripts": {
		"build": "pnpm -r --if-present build",
		"dev": "pnpm --filter @arbitrum/litro... build && pnpm --filter @arbitrum/litro dev",
		"test": "vitest",
		"test:run": "vitest run",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"typecheck": "tsc -b",
		"typecheck:test": "tsc -p tsconfig.test.json",
		"release": "node scripts/release.mjs",
		"validate": "pnpm lint && pnpm build && pnpm typecheck && pnpm typecheck:test && pnpm test:run"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.0",
		"@types/node": "^26",
		"tsx": "^4.19.0",
		"typescript": "^5.7.0",
		"vitest": "^2.1.0"
	}
}
