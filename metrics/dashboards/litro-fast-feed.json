{
	"uid": "litro-fast-feed",
	"title": "Fast Feed relay",
	"description": "The local Fast Feed relay: who is connected, how fast transactions reach them, and why clients were turned away or dropped.",
	"tags": [
		"litro",
		"fast-feed"
	],
	"timezone": "browser",
	"editable": true,
	"graphTooltip": 1,
	"refresh": "5s",
	"time": {
		"from": "now-15m",
		"to": "now"
	},
	"schemaVersion": 39,
	"version": 1,
	"templating": {
		"list": []
	},
	"annotations": {
		"list": []
	},
	"panels": [
		{
			"id": 1,
			"type": "stat",
			"title": "Clients connected",
			"description": "Clients holding a Fast Feed connection now.",
			"datasource": {
				"type": "prometheus",
				"uid": "prometheus"
			},
			"gridPos": {
				"x": 0,
				"y": 0,
				"w": 8,
				"h": 4
			},
			"targets": [
				{
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"refId": "A",
					"expr": "litro_fast_feed_clients",
					"legendFormat": "clients"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "short"
				},
				"overrides": []
			},
			"options": {
				"reduceOptions": {
					"calcs": [
						"lastNotNull"
					],
					"values": false
				},
				"textMode": "value_and_name",
				"colorMode": "none",
				"graphMode": "none"
			}
		},
		{
			"id": 2,
			"type": "stat",
			"title": "Upstream connected",
			"description": "Whether the relay is connected to Nitro's transaction feed (1 = connected). At 0, clients stay connected but receive nothing.",
			"datasource": {
				"type": "prometheus",
				"uid": "prometheus"
			},
			"gridPos": {
				"x": 8,
				"y": 0,
				"w": 8,
				"h": 4
			},
			"targets": [
				{
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"refId": "A",
					"expr": "litro_fast_feed_upstream_connected",
					"legendFormat": "upstream"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "short"
				},
				"overrides": []
			},
			"options": {
				"reduceOptions": {
					"calcs": [
						"lastNotNull"
					],
					"values": false
				},
				"textMode": "value_and_name",
				"colorMode": "none",
				"graphMode": "none"
			}
		},
		{
			"id": 3,
			"type": "stat",
			"title": "Upstream reconnects",
			"description": "Times the relay had to reconnect to Nitro's transaction feed.",
			"datasource": {
				"type": "prometheus",
				"uid": "prometheus"
			},
			"gridPos": {
				"x": 16,
				"y": 0,
				"w": 8,
				"h": 4
			},
			"targets": [
				{
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"refId": "A",
					"expr": "litro_fast_feed_upstream_reconnects_total",
					"legendFormat": "reconnects"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "short"
				},
				"overrides": []
			},
			"options": {
				"reduceOptions": {
					"calcs": [
						"lastNotNull"
					],
					"values": false
				},
				"textMode": "value_and_name",
				"colorMode": "none",
				"graphMode": "none"
			}
		},
		{
			"id": 4,
			"type": "timeseries",
			"title": "Delivery latency",
			"description": "Age of each transaction as the relay sends it, from the moment the sequencer sequenced it (timestamp_ms): median and 99th percentile. Includes any --fast-feed-delay-ms.",
			"datasource": {
				"type": "prometheus",
				"uid": "prometheus"
			},
			"gridPos": {
				"x": 0,
				"y": 4,
				"w": 12,
				"h": 8
			},
			"targets": [
				{
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"refId": "A",
					"expr": "histogram_quantile(0.5, sum by (le) (rate(litro_fast_feed_delivery_latency_ms_bucket[1m])))",
					"legendFormat": "p50"
				},
				{
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"refId": "B",
					"expr": "histogram_quantile(0.99, sum by (le) (rate(litro_fast_feed_delivery_latency_ms_bucket[1m])))",
					"legendFormat": "p99"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "ms",
					"min": 0,
					"custom": {
						"lineWidth": 2,
						"fillOpacity": 10,
						"stacking": {
							"mode": "none"
						},
						"showPoints": "never"
					}
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"displayMode": "list",
					"placement": "bottom"
				},
				"tooltip": {
					"mode": "multi",
					"sort": "desc"
				}
			}
		},
		{
			"id": 5,
			"type": "timeseries",
			"title": "Transactions per second",
			"description": "Transactions relayed to clients per second. User transactions should match the L2 on the Litro chains dashboard; all frames also include the ArbOS transaction Nitro sequences at the start of every block.",
			"datasource": {
				"type": "prometheus",
				"uid": "prometheus"
			},
			"gridPos": {
				"x": 12,
				"y": 4,
				"w": 12,
				"h": 8
			},
			"targets": [
				{
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"refId": "A",
					"expr": "rate(litro_fast_feed_user_frames_total[30s])",
					"legendFormat": "user transactions"
				},
				{
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"refId": "B",
					"expr": "rate(litro_fast_feed_frames_total[30s])",
					"legendFormat": "all frames"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "short",
					"min": 0,
					"custom": {
						"lineWidth": 2,
						"fillOpacity": 10,
						"stacking": {
							"mode": "none"
						},
						"showPoints": "never"
					}
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"displayMode": "list",
					"placement": "bottom"
				},
				"tooltip": {
					"mode": "multi",
					"sort": "desc"
				}
			}
		},
		{
			"id": 6,
			"type": "timeseries",
			"title": "Rejected connections",
			"description": "Upgrade requests refused in the last minute, by HTTP status: 401 wrong or missing API key, 429 the key is already connected, 426 not a WebSocket upgrade.",
			"datasource": {
				"type": "prometheus",
				"uid": "prometheus"
			},
			"gridPos": {
				"x": 0,
				"y": 12,
				"w": 12,
				"h": 8
			},
			"targets": [
				{
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"refId": "A",
					"expr": "sum by (status) (increase(litro_fast_feed_rejected_total[1m])) or label_replace(vector(0), \"status\", \"none\", \"\", \"\")",
					"legendFormat": "HTTP {{status}}"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "short",
					"min": 0,
					"custom": {
						"lineWidth": 2,
						"fillOpacity": 10,
						"stacking": {
							"mode": "none"
						},
						"showPoints": "never"
					}
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"displayMode": "list",
					"placement": "bottom"
				},
				"tooltip": {
					"mode": "multi",
					"sort": "desc"
				}
			}
		},
		{
			"id": 7,
			"type": "timeseries",
			"title": "Clients closed by the relay",
			"description": "Connections the relay closed in the last minute, by close code: 1013 client fell behind, 1003 client sent data, 1008 round ended, 1011 relay shutting down.",
			"datasource": {
				"type": "prometheus",
				"uid": "prometheus"
			},
			"gridPos": {
				"x": 12,
				"y": 12,
				"w": 12,
				"h": 8
			},
			"targets": [
				{
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"refId": "A",
					"expr": "sum by (code) (increase(litro_fast_feed_closed_total[1m])) or label_replace(vector(0), \"code\", \"none\", \"\", \"\")",
					"legendFormat": "close {{code}}"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "short",
					"min": 0,
					"custom": {
						"lineWidth": 2,
						"fillOpacity": 10,
						"stacking": {
							"mode": "none"
						},
						"showPoints": "never"
					}
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"displayMode": "list",
					"placement": "bottom"
				},
				"tooltip": {
					"mode": "multi",
					"sort": "desc"
				}
			}
		}
	]
}
