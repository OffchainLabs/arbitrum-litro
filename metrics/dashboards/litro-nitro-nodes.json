		{
			"id": 17,
			"type": "timeseries",
			"title": "Assertion posting errors",
			"description": "Failed attempts to post an assertion, per minute, beside assertions actually created on the parent chain. Under load, litro's fast validator retries assertions it has just posted (item not found on-chain, EXPECTED_ASSERTION_SEEN); errors only matter when assertions stop being created.",
			"datasource": {
				"type": "prometheus",
				"uid": "prometheus"
			},
			"gridPos": {
				"x": 0,
				"y": 52,
				"w": 12,
				"h": 8
			},
			"targets": [
				{
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"refId": "A",
					"expr": "rate(arb_validator_poster_error_posting_assertion{node=~\"$node\"}[1m]) * 60",
					"legendFormat": "{{node}} errors"
				},
				{
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"refId": "B",
					"expr": "increase(litro_rollup_assertions_created_total[1m])",
					"legendFormat": "{{chain}} assertions created"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "short",
					"custom": {
						"lineWidth": 2,
						"fillOpacity": 10,
						"stacking": {
