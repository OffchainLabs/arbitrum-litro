{
	"uid": "litro-nitro-nodes",
	"title": "Nitro nodes",
	"description": "What each Nitro node is doing: keeping up with the sequencer, sequencing, posting batches, and the resources it uses. Panels that only matter when something breaks are in Diagnostics.",
	"tags": [
		"litro",
		"nitro"
	],
	"timezone": "browser",
	"editable": true,
	"graphTooltip": 1,
	"refresh": "5s",
	"time": {
		"from": "now-15m",
		"to": "now"
	},
	"schemaVersion": 39,
	"version": 1,
	"templating": {
		"list": [
			{
				"name": "node",
				"label": "Node",
				"type": "query",
				"datasource": {
					"type": "prometheus",
					"uid": "prometheus"
				},
				"query": {
					"query": "label_values(up{job=\"nitro\"}, node)",
					"refId": "variable"
				},
				"definition": "label_values(up{job=\"nitro\"}, node)",
				"refresh": 2,
				"sort": 1,
				"multi": true,
				"includeAll": true,
				"current": {
					"text": "All",
					"value": "$__all"
				}
			}
		]
	},
	"annotations": {
		"list": []
	},
	"panels": [
		{
			"id": 1,
			"type": "row",
			"title": "Is each node keeping up?",
			"collapsed": false,
			"gridPos": {
				"x": 0,
				"y": 0,
				"w": 24,
				"h": 1
			},
			"panels": []
		},
		{
			"id": 2,
			"type": "timeseries",
			"title": "Blocks behind the sequencer",
			"description": "How far each node trails the newest block of its chain. Under load the validator falls behind and catches up; one that keeps falling behind delays assertions, and so withdrawals.",
			"datasource": {
				"type": "prometheus",
				"uid": "prometheus"
			},
			"gridPos": {
				"x": 0,
				"y": 1,
				"w": 24,
				"h": 8
			},
			"targets": [
				{
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"refId": "A",
					"expr": "max by (chain) (chain_head_block) - on (chain) group_right chain_head_block{node=~\"$node\"}",
					"legendFormat": "{{node}}"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "short",
					"min": 0,
					"custom": {
						"lineWidth": 2,
						"fillOpacity": 10,
						"stacking": {
							"mode": "none"
						},
						"showPoints": "never"
					}
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"displayMode": "list",
					"placement": "bottom"
				},
				"tooltip": {
					"mode": "multi",
					"sort": "desc"
				}
			}
		},
		{
			"id": 3,
			"type": "row",
			"title": "Sequencer",
			"collapsed": false,
			"gridPos": {
				"x": 0,
				"y": 9,
				"w": 24,
				"h": 1
			},
			"panels": []
		},
		{
			"id": 4,
			"type": "timeseries",
			"title": "Block build time",
			"description": "Time the sequencer takes to build a block, median and 99th percentile. The number to watch when booting your own Nitro build with --nitro-image.",
			"datasource": {
				"type": "prometheus",
				"uid": "prometheus"
			},
			"gridPos": {
				"x": 0,
				"y": 10,
				"w": 12,
				"h": 8
			},
			"targets": [
				{
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"refId": "A",
					"expr": "arb_sequencer_block_creation{quantile=\"0.5\", node=~\"$node\"}",
					"legendFormat": "{{node}} p50"
				},
				{
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"refId": "B",
					"expr": "arb_sequencer_block_creation{quantile=\"0.99\", node=~\"$node\"}",
					"legendFormat": "{{node}} p99"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "ns",
					"min": 0,
					"custom": {
						"lineWidth": 2,
						"fillOpacity": 10,
						"stacking": {
							"mode": "none"
						},
						"showPoints": "never"
					}
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"displayMode": "list",
					"placement": "bottom"
				},
				"tooltip": {
					"mode": "multi",
					"sort": "desc"
				}
			}
		},
		{
			"id": 5,
			"type": "timeseries",
			"title": "Why blocks closed",
			"description": "Blocks per second by what ended them. Queue empty means the sequencer kept up; gas, data or time limits mean load reached the chain's capacity. Only reasons that occurred are shown.",
			"datasource": {
				"type": "prometheus",
				"uid": "prometheus"
			},
			"gridPos": {
				"x": 12,
				"y": 10,
				"w": 12,
				"h": 8
			},
			"targets": [
				{
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"refId": "A",
					"expr": "(rate(arb_sequencer_block_txexhausted{node=~\"$node\"}[30s])) > 0",
					"legendFormat": "{{node}} queue empty"
				},
				{
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"refId": "B",
					"expr": "(rate(arb_sequencer_block_gaslimited{node=~\"$node\"}[30s])) > 0",
					"legendFormat": "{{node}} gas limit"
				},
				{
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"refId": "C",
					"expr": "(rate(arb_sequencer_block_datalimited{node=~\"$node\"}[30s])) > 0",
					"legendFormat": "{{node}} data limit"
				},
				{
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"refId": "D",
					"expr": "(rate(arb_sequencer_block_timelimited{node=~\"$node\"}[30s])) > 0",
					"legendFormat": "{{node}} time limit"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "short",
					"min": 0,
					"custom": {
						"lineWidth": 2,
						"fillOpacity": 30,
						"stacking": {
							"mode": "normal"
						},
						"showPoints": "never"
					}
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"displayMode": "list",
					"placement": "bottom"
				},
				"tooltip": {
					"mode": "multi",
					"sort": "desc"
				}
			}
		},
		{
			"id": 6,
			"type": "timeseries",
			"title": "Transaction ordering",
			"description": "Transactions ordered first-come-first-served versus by priority gas auction. PGA appears only with --pga-rounds-per-block.",
			"datasource": {
				"type": "prometheus",
				"uid": "prometheus"
			},
			"gridPos": {
				"x": 0,
				"y": 18,
				"w": 12,
				"h": 8
			},
			"targets": [
				{
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"refId": "A",
					"expr": "(rate(arb_sequencer_ordering_fifo{node=~\"$node\"}[30s])) > 0",
					"legendFormat": "{{node}} FIFO"
				},
				{
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"refId": "B",
					"expr": "(rate(arb_sequencer_ordering_pga{node=~\"$node\"}[30s])) > 0",
					"legendFormat": "{{node}} PGA"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "short",
					"min": 0,
					"custom": {
						"lineWidth": 2,
						"fillOpacity": 30,
						"stacking": {
							"mode": "normal"
						},
						"showPoints": "never"
					}
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"displayMode": "list",
					"placement": "bottom"
				},
				"tooltip": {
					"mode": "multi",
					"sort": "desc"
				}
			}
		},
		{
			"id": 7,
			"type": "stat",
			"title": "Most transactions queued",
			"description": "The longest the sequencer's queue got in the time range. Above a handful means transactions arrive faster than blocks are built.",
			"datasource": {
				"type": "prometheus",
				"uid": "prometheus"
			},
			"gridPos": {
				"x": 12,
				"y": 18,
				"w": 6,
				"h": 4
			},
			"targets": [
				{
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"refId": "A",
					"expr": "max_over_time(arb_sequencer_queue_length{node=~\"$node\"}[$__range])",
					"legendFormat": "{{node}}"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "short"
				},
				"overrides": []
			},
			"options": {
				"reduceOptions": {
					"calcs": [
						"lastNotNull"
					],
					"values": false
				},
				"textMode": "value_and_name",
				"colorMode": "none",
				"graphMode": "none"
			}
		},
		{
			"id": 8,
			"type": "stat",
			"title": "Dropped transactions",
			"description": "Transactions the sequencer dropped in the time range because they waited too long in its queue or were canceled.",
			"datasource": {
				"type": "prometheus",
				"uid": "prometheus"
			},
			"gridPos": {
				"x": 18,
				"y": 18,
				"w": 6,
				"h": 4
			},
			"targets": [
				{
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"refId": "A",
					"expr": "sum by (node) (increase(arb_sequencer_transactions_dropped_queuetimeout{node=~\"$node\"}[$__range]) + increase(arb_sequencer_transactions_dropped_canceled{node=~\"$node\"}[$__range]))",
					"legendFormat": "{{node}}"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "short"
				},
				"overrides": []
			},
			"options": {
				"reduceOptions": {
					"calcs": [
						"lastNotNull"
					],
					"values": false
				},
				"textMode": "value_and_name",
				"colorMode": "none",
				"graphMode": "none"
			}
		},
		{
			"id": 9,
			"type": "row",
			"title": "Batch poster",
			"collapsed": false,
			"gridPos": {
				"x": 0,
				"y": 26,
				"w": 24,
				"h": 1
			},
			"panels": []
		},
		{
			"id": 10,
			"type": "stat",
			"title": "Batch poster wallet",
			"description": "ETH each batch poster has left to pay for posting on its parent chain. At zero, batches stop. The L3 poster pays in L2 ETH and starts with far less than the L2 poster.",
			"datasource": {
				"type": "prometheus",
				"uid": "prometheus"
			},
			"gridPos": {
				"x": 0,
				"y": 27,
				"w": 8,
				"h": 4
			},
			"targets": [
				{
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"refId": "A",
					"expr": "arb_batchposter_wallet_eth{node=~\"$node\", node!~\".*validator\"}",
					"legendFormat": "{{node}}"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "short",
					"decimals": 4
				},
				"overrides": []
			},
			"options": {
				"reduceOptions": {
					"calcs": [
						"lastNotNull"
					],
					"values": false
				},
				"textMode": "value_and_name",
				"colorMode": "none",
				"graphMode": "none"
			}
		},
		{
			"id": 11,
			"type": "stat",
			"title": "Posting failures",
			"description": "Failed batch-posting attempts in the time range.",
			"datasource": {
				"type": "prometheus",
				"uid": "prometheus"
			},
			"gridPos": {
				"x": 8,
				"y": 27,
				"w": 4,
				"h": 4
			},
			"targets": [
				{
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"refId": "A",
					"expr": "increase(arb_batchPoster_action_failure{node=~\"$node\", node!~\".*validator\"}[$__range])",
					"legendFormat": "{{node}}"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "short"
				},
				"overrides": []
			},
			"options": {
				"reduceOptions": {
					"calcs": [
						"lastNotNull"
					],
					"values": false
				},
				"textMode": "value_and_name",
				"colorMode": "none",
				"graphMode": "none"
			}
		},
		{
			"id": 12,
			"type": "timeseries",
			"title": "Parent-chain transactions pending",
			"description": "Transactions the data poster (batches, assertions) has sent to the parent chain that are not mined yet. It rises under load and should drain back to zero.",
			"datasource": {
				"type": "prometheus",
				"uid": "prometheus"
			},
			"gridPos": {
				"x": 12,
				"y": 27,
				"w": 12,
				"h": 8
			},
			"targets": [
				{
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"refId": "A",
					"expr": "clamp_min(arb_dataposter_nonce_unconfirmed{node=~\"$node\"} - arb_dataposter_nonce_softconfirmed{node=~\"$node\"}, 0)",
					"legendFormat": "{{node}}"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "short",
					"min": 0,
					"custom": {
						"lineWidth": 2,
						"fillOpacity": 10,
						"stacking": {
							"mode": "none"
						},
						"showPoints": "never"
					}
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"displayMode": "list",
					"placement": "bottom"
				},
				"tooltip": {
					"mode": "multi",
					"sort": "desc"
				}
			}
		},
		{
			"id": 13,
			"type": "row",
			"title": "Resources",
			"collapsed": false,
			"gridPos": {
				"x": 0,
				"y": 35,
				"w": 24,
				"h": 1
			},
			"panels": []
		},
		{
			"id": 14,
			"type": "timeseries",
			"title": "CPU",
			"description": "CPU used by each node's process.",
			"datasource": {
				"type": "prometheus",
				"uid": "prometheus"
			},
			"gridPos": {
				"x": 0,
				"y": 36,
				"w": 12,
				"h": 8
			},
			"targets": [
				{
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"refId": "A",
					"expr": "system_cpu_procload{node=~\"$node\"}",
					"legendFormat": "{{node}}"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "percent",
					"min": 0,
					"custom": {
						"lineWidth": 2,
