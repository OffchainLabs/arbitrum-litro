		{
			"id": 13,
			"type": "stat",
			"title": "Batch poster wallet",
			"description": "ETH the batch poster has left to pay for posting on the parent chain. At zero, batches stop. The L3 poster pays in L2 ETH and starts with far less than the L2 poster.",
			"datasource": {
				"type": "prometheus",
				"uid": "prometheus"
			},
			"gridPos": {
				"x": 12,
				"y": 35,
				"w": 12,
				"h": 4
			},
			"targets": [
				{
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"refId": "A",
					"expr": "arb_batchposter_wallet_eth{node=~\"$node\"}",
					"legendFormat": "{{node}}"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "short",
					"decimals": 4
				},
				"overrides": []
			},
			"options": {
