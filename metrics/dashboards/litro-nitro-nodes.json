		{
			"id": 18,
			"type": "row",
			"title": "Diagnostics",
			"collapsed": true,
			"gridPos": {
				"x": 0,
				"y": 52,
				"w": 24,
				"h": 1
			},
			"panels": [
				{
					"id": 19,
					"type": "timeseries",
					"title": "Assertion posting errors",
					"description": "Failed attempts to post an assertion, per minute. Under load litro's fast validator retries assertions it has just posted (item not found on-chain, EXPECTED_ASSERTION_SEEN); it matters only if Time since last assertion on the Litro chains dashboard keeps climbing.",
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"gridPos": {
						"x": 0,
						"y": 53,
						"w": 12,
						"h": 8
					},
					"targets": [
						{
							"datasource": {
								"type": "prometheus",
								"uid": "prometheus"
							},
							"refId": "A",
							"expr": "rate(arb_validator_poster_error_posting_assertion{node=~\"$node\"}[1m]) * 60",
							"legendFormat": "{{node}}"
						}
					],
					"fieldConfig": {
						"defaults": {
							"unit": "short",
							"min": 0,
							"custom": {
								"lineWidth": 2,
								"fillOpacity": 10,
								"stacking": {
									"mode": "none"
								},
								"showPoints": "never"
							}
						},
						"overrides": []
					},
					"options": {
