					"sort": "desc"
				}
			}
		},
		{
			"id": 17,
			"type": "timeseries",
			"title": "Disk I/O",
			"description": "Bytes each node reads and writes per second.",
			"datasource": {
				"type": "prometheus",
				"uid": "prometheus"
			},
			"gridPos": {
				"x": 12,
				"y": 44,
				"w": 12,
				"h": 8
			},
			"targets": [
				{
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"refId": "A",
					"expr": "rate(system_disk_readbytes{node=~\"$node\"}[30s])",
					"legendFormat": "{{node}} read"
				},
				{
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"refId": "B",
					"expr": "rate(system_disk_writebytes{node=~\"$node\"}[30s])",
