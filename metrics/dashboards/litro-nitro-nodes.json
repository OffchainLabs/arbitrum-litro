				"tooltip": {
					"mode": "multi",
					"sort": "desc"
				}
			}
		},
		{
			"id": 9,
			"type": "timeseries",
			"title": "Transaction ordering",
			"description": "Transactions ordered first-come-first-served versus by priority gas auction (PGA rounds).",
			"datasource": {
