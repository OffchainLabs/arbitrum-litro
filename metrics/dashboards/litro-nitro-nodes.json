				{
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"refId": "B",
					"expr": "rate(arb_sequencer_ordering_pga{node=~\"$node\"}[30s])",
					"legendFormat": "{{node}} PGA"
