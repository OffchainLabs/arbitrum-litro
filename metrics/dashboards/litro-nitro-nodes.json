{
	"uid": "litro-nitro-nodes",
	"title": "Nitro nodes",
	"description": "What each Nitro node is doing: keeping up, sequencing, posting batches, asserting, serving feeds, and the resources it uses.",
	"tags": [
		"litro",
		"nitro"
	],
	"timezone": "browser",
	"editable": true,
	"graphTooltip": 1,
	"refresh": "5s",
	"time": {
		"from": "now-15m",
		"to": "now"
	},
	"schemaVersion": 39,
	"version": 1,
	"templating": {
		"list": [
			{
				"name": "node",
				"label": "Node",
				"type": "query",
				"datasource": {
					"type": "prometheus",
					"uid": "prometheus"
				},
				"query": {
					"query": "label_values(up{job=\"nitro\"}, node)",
					"refId": "variable"
				},
				"definition": "label_values(up{job=\"nitro\"}, node)",
				"refresh": 2,
				"sort": 1,
				"multi": true,
				"includeAll": true,
				"current": {
					"text": "All",
					"value": "$__all"
				}
			}
		]
	},
	"annotations": {
		"list": []
	},
	"panels": [
		{
			"id": 1,
			"type": "row",
			"title": "Is each node keeping up?",
			"collapsed": false,
			"gridPos": {
				"x": 0,
				"y": 0,
				"w": 24,
				"h": 1
			},
			"panels": []
		},
		{
			"id": 2,
			"type": "stat",
			"title": "Head block",
			"description": "Latest block each node has processed.",
			"datasource": {
				"type": "prometheus",
				"uid": "prometheus"
			},
			"gridPos": {
				"x": 0,
				"y": 1,
				"w": 8,
				"h": 4
			},
			"targets": [
				{
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"refId": "A",
					"expr": "chain_head_block{node=~\"$node\"}",
					"legendFormat": "{{node}}"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "short"
				},
				"overrides": []
			},
			"options": {
				"reduceOptions": {
					"calcs": [
						"lastNotNull"
					],
					"values": false
				},
				"textMode": "value_and_name",
				"colorMode": "none",
				"graphMode": "none"
			}
		},
		{
			"id": 3,
			"type": "timeseries",
			"title": "Blocks behind the sequencer",
			"description": "How far each node trails the newest block any node of the same chain has. A validator that keeps falling behind cannot assert recent state.",
			"datasource": {
				"type": "prometheus",
				"uid": "prometheus"
			},
			"gridPos": {
				"x": 8,
				"y": 1,
				"w": 16,
				"h": 8
			},
			"targets": [
				{
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"refId": "A",
					"expr": "max by (chain) (chain_head_block) - on (chain) group_right chain_head_block{node=~\"$node\"}",
					"legendFormat": "{{node}}"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "short",
					"custom": {
						"lineWidth": 2,
						"fillOpacity": 10,
						"stacking": {
							"mode": "none"
						},
						"showPoints": "never"
					}
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"displayMode": "list",
					"placement": "bottom"
				},
				"tooltip": {
					"mode": "multi",
					"sort": "desc"
				}
			}
		},
		{
			"id": 4,
			"type": "row",
			"title": "Sequencer",
			"collapsed": false,
			"gridPos": {
				"x": 0,
				"y": 9,
				"w": 24,
				"h": 1
			},
			"panels": []
		},
		{
			"id": 5,
			"type": "timeseries",
			"title": "Sequencer queue",
			"description": "Transactions waiting to be sequenced, and the sequencer's backlog. Growing queues mean transactions arrive faster than blocks are built.",
			"datasource": {
				"type": "prometheus",
				"uid": "prometheus"
			},
			"gridPos": {
				"x": 0,
				"y": 10,
				"w": 12,
				"h": 8
			},
			"targets": [
				{
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"refId": "A",
					"expr": "arb_sequencer_queue_length{node=~\"$node\"}",
					"legendFormat": "{{node}} queue"
				},
				{
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"refId": "B",
					"expr": "arb_sequencer_backlog{node=~\"$node\"}",
					"legendFormat": "{{node}} backlog"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "short",
					"custom": {
						"lineWidth": 2,
						"fillOpacity": 10,
						"stacking": {
							"mode": "none"
						},
						"showPoints": "never"
					}
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"displayMode": "list",
					"placement": "bottom"
				},
				"tooltip": {
					"mode": "multi",
					"sort": "desc"
				}
			}
		},
		{
			"id": 6,
			"type": "timeseries",
			"title": "Block build time",
			"description": "Time the sequencer takes to build a block, median and 99th percentile.",
			"datasource": {
				"type": "prometheus",
				"uid": "prometheus"
			},
			"gridPos": {
				"x": 12,
				"y": 10,
				"w": 12,
				"h": 8
			},
			"targets": [
				{
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"refId": "A",
					"expr": "arb_sequencer_block_creation{quantile=\"0.5\", node=~\"$node\"}",
					"legendFormat": "{{node}} p50"
				},
				{
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"refId": "B",
					"expr": "arb_sequencer_block_creation{quantile=\"0.99\", node=~\"$node\"}",
					"legendFormat": "{{node}} p99"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "ns",
					"custom": {
						"lineWidth": 2,
						"fillOpacity": 10,
						"stacking": {
							"mode": "none"
						},
						"showPoints": "never"
					}
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"displayMode": "list",
					"placement": "bottom"
				},
				"tooltip": {
					"mode": "multi",
					"sort": "desc"
				}
			}
		},
		{
			"id": 7,
			"type": "timeseries",
			"title": "Why blocks closed",
			"description": "Blocks per second, by what ended them: the queue ran dry (tx exhausted), or the block hit its gas, data or time limit. Limited blocks under load mean you are hitting the chain's capacity.",
			"datasource": {
				"type": "prometheus",
				"uid": "prometheus"
			},
			"gridPos": {
				"x": 0,
				"y": 18,
				"w": 12,
				"h": 8
			},
			"targets": [
				{
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"refId": "A",
					"expr": "rate(arb_sequencer_block_txexhausted{node=~\"$node\"}[30s])",
					"legendFormat": "{{node}} queue empty"
				},
				{
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"refId": "B",
					"expr": "rate(arb_sequencer_block_gaslimited{node=~\"$node\"}[30s])",
					"legendFormat": "{{node}} gas limit"
				},
				{
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"refId": "C",
					"expr": "rate(arb_sequencer_block_datalimited{node=~\"$node\"}[30s])",
					"legendFormat": "{{node}} data limit"
				},
				{
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"refId": "D",
					"expr": "rate(arb_sequencer_block_timelimited{node=~\"$node\"}[30s])",
					"legendFormat": "{{node}} time limit"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "short",
					"custom": {
						"lineWidth": 2,
						"fillOpacity": 30,
						"stacking": {
							"mode": "normal"
						},
						"showPoints": "never"
					}
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"displayMode": "list",
					"placement": "bottom"
				},
				"tooltip": {
					"mode": "multi",
					"sort": "desc"
				}
			}
		},
		{
			"id": 8,
			"type": "timeseries",
			"title": "Dropped transactions",
			"description": "Transactions the sequencer dropped because they waited too long in its queue or the sender canceled them.",
			"datasource": {
				"type": "prometheus",
				"uid": "prometheus"
			},
			"gridPos": {
				"x": 12,
				"y": 18,
				"w": 12,
				"h": 8
			},
			"targets": [
				{
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"refId": "A",
					"expr": "rate(arb_sequencer_transactions_dropped_queuetimeout{node=~\"$node\"}[1m])",
					"legendFormat": "{{node}} queue timeout"
				},
				{
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"refId": "B",
					"expr": "rate(arb_sequencer_transactions_dropped_canceled{node=~\"$node\"}[1m])",
					"legendFormat": "{{node}} canceled"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "short",
					"custom": {
						"lineWidth": 2,
						"fillOpacity": 30,
						"stacking": {
							"mode": "normal"
