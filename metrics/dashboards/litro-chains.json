{
	"uid": "litro-chains",
	"title": "Litro chains",
	"description": "Every chain the testnode runs, L1 to L3: is it running, how much load it carries, and whether deposits, batches and assertions are moving between each chain and its parent.",
	"tags": [
		"litro",
		"chains"
	],
	"timezone": "browser",
	"editable": true,
	"graphTooltip": 1,
	"refresh": "5s",
	"time": {
		"from": "now-15m",
		"to": "now"
	},
	"schemaVersion": 39,
	"version": 1,
	"templating": {
		"list": [
			{
				"name": "chain",
				"label": "chain",
				"type": "query",
				"datasource": {
					"type": "prometheus",
					"uid": "prometheus"
				},
				"query": {
					"query": "label_values(eth_exe_block_most_recent_number, chain)",
					"refId": "variable"
				},
				"definition": "label_values(eth_exe_block_most_recent_number, chain)",
				"refresh": 2,
				"sort": 1,
				"multi": true,
				"includeAll": true,
				"current": {
					"text": "All",
					"value": "$__all"
				}
			}
		]
	},
	"annotations": {
		"list": []
	},
	"panels": [
		{
			"id": 1,
			"type": "row",
			"title": "Is it running?",
			"collapsed": false,
			"gridPos": {
				"x": 0,
				"y": 0,
				"w": 24,
				"h": 1
			},
			"panels": []
		},
		{
			"id": 2,
			"type": "stat",
			"title": "RPC up",
			"description": "Whether each chain's RPC answered the exporter's last poll (1 = up).",
			"datasource": {
				"type": "prometheus",
				"uid": "prometheus"
			},
			"gridPos": {
				"x": 0,
				"y": 1,
				"w": 6,
				"h": 4
			},
			"targets": [
				{
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"refId": "A",
					"expr": "litro_rpc_up{chain=~\"$chain\"}",
					"legendFormat": "{{chain}}"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "short"
				},
				"overrides": []
			},
			"options": {
				"reduceOptions": {
					"calcs": [
						"lastNotNull"
					],
					"values": false
				},
				"textMode": "value_and_name",
				"colorMode": "none",
				"graphMode": "none"
			}
		},
		{
			"id": 3,
			"type": "stat",
			"title": "Head block",
			"description": "Latest block number per chain.",
			"datasource": {
				"type": "prometheus",
				"uid": "prometheus"
			},
			"gridPos": {
				"x": 6,
				"y": 1,
				"w": 6,
				"h": 4
			},
			"targets": [
				{
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"refId": "A",
					"expr": "eth_exe_block_most_recent_number{chain=~\"$chain\"}",
					"legendFormat": "{{chain}}"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "short"
				},
				"overrides": []
			},
			"options": {
				"reduceOptions": {
					"calcs": [
						"lastNotNull"
					],
					"values": false
				},
				"textMode": "value_and_name",
				"colorMode": "none",
				"graphMode": "none"
			}
		},
		{
			"id": 4,
			"type": "stat",
			"title": "L1 head block age",
			"description": "Seconds since the L1 (Anvil) mined a block. It mines one a second, so anything above a few seconds means the L1 has stopped.",
			"datasource": {
				"type": "prometheus",
				"uid": "prometheus"
			},
			"gridPos": {
				"x": 12,
				"y": 1,
				"w": 4,
				"h": 4
			},
			"targets": [
				{
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"refId": "A",
					"expr": "time() - litro_block_timestamp_seconds{chain=\"l1\"}",
					"legendFormat": "l1"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "s",
					"decimals": 0
				},
				"overrides": []
			},
			"options": {
				"reduceOptions": {
					"calcs": [
						"lastNotNull"
					],
					"values": false
				},
				"textMode": "value_and_name",
				"colorMode": "none",
				"graphMode": "none"
			}
		},
		{
			"id": 5,
			"type": "stat",
			"title": "Last transaction",
			"description": "Seconds since each Arbitrum chain included a user transaction. Nitro produces blocks only when there is something to sequence, so this is how long the chain has been idle.",
			"datasource": {
				"type": "prometheus",
				"uid": "prometheus"
			},
			"gridPos": {
				"x": 16,
				"y": 1,
				"w": 4,
				"h": 4
			},
			"targets": [
				{
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"refId": "A",
					"expr": "time() - litro_last_user_transaction_timestamp_seconds{chain=~\"$chain\", chain!=\"l1\"}",
					"legendFormat": "{{chain}}"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "s",
					"decimals": 0
				},
				"overrides": []
			},
			"options": {
				"reduceOptions": {
					"calcs": [
						"lastNotNull"
					],
					"values": false
				},
				"textMode": "value_and_name",
				"colorMode": "none",
				"graphMode": "none"
			}
		},
		{
			"id": 6,
			"type": "stat",
			"title": "ArbOS version",
			"description": "ArbOS version each Arbitrum chain runs; 60 once --pga-rounds-per-block has upgraded it.",
			"datasource": {
				"type": "prometheus",
				"uid": "prometheus"
			},
			"gridPos": {
				"x": 20,
				"y": 1,
				"w": 4,
				"h": 4
			},
			"targets": [
				{
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"refId": "A",
					"expr": "litro_arbos_version{chain=~\"$chain\"}",
					"legendFormat": "{{chain}}"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "short"
				},
				"overrides": []
			},
			"options": {
				"reduceOptions": {
					"calcs": [
						"lastNotNull"
					],
					"values": false
				},
				"textMode": "value_and_name",
				"colorMode": "none",
				"graphMode": "none"
			}
		},
		{
			"id": 7,
			"type": "row",
			"title": "Load",
			"collapsed": false,
			"gridPos": {
				"x": 0,
				"y": 5,
				"w": 24,
				"h": 1
			},
			"panels": []
		},
		{
			"id": 8,
			"type": "timeseries",
			"title": "Transactions per second",
			"description": "User transactions included per second, per chain. ArbOS's own start-of-block transaction is not counted.",
			"datasource": {
				"type": "prometheus",
				"uid": "prometheus"
			},
			"gridPos": {
				"x": 0,
				"y": 6,
				"w": 12,
				"h": 8
			},
			"targets": [
				{
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"refId": "A",
					"expr": "rate(litro_transactions_total{chain=~\"$chain\"}[30s])",
					"legendFormat": "{{chain}}"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "short",
					"min": 0,
					"custom": {
						"lineWidth": 2,
						"fillOpacity": 10,
						"stacking": {
							"mode": "none"
						},
						"showPoints": "never"
					}
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"displayMode": "list",
					"placement": "bottom"
				},
				"tooltip": {
					"mode": "multi",
					"sort": "desc"
				}
			}
		},
		{
			"id": 9,
			"type": "timeseries",
			"title": "Failed transactions per second",
			"description": "User transactions that were included but reverted. A reverting contract call shows here, not as an RPC error.",
			"datasource": {
				"type": "prometheus",
				"uid": "prometheus"
			},
			"gridPos": {
				"x": 12,
				"y": 6,
				"w": 12,
				"h": 8
			},
			"targets": [
				{
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"refId": "A",
					"expr": "rate(litro_failed_transactions_total{chain=~\"$chain\"}[30s])",
					"legendFormat": "{{chain}}"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "short",
					"min": 0,
					"custom": {
						"lineWidth": 2,
						"fillOpacity": 10,
						"stacking": {
							"mode": "none"
						},
						"showPoints": "never"
					}
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"displayMode": "list",
					"placement": "bottom"
				},
				"tooltip": {
					"mode": "multi",
					"sort": "desc"
				}
			}
		},
		{
			"id": 10,
			"type": "timeseries",
			"title": "Gas per second",
			"description": "Gas used per second, per chain. On the L1 this is mostly the batch poster and validator paying to post the rollups' data.",
			"datasource": {
				"type": "prometheus",
				"uid": "prometheus"
			},
			"gridPos": {
				"x": 0,
				"y": 14,
				"w": 12,
				"h": 8
			},
			"targets": [
				{
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"refId": "A",
					"expr": "rate(litro_gas_used_total{chain=~\"$chain\"}[30s])",
					"legendFormat": "{{chain}}"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "short",
					"min": 0,
					"custom": {
						"lineWidth": 2,
						"fillOpacity": 10,
						"stacking": {
							"mode": "none"
						},
						"showPoints": "never"
					}
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"displayMode": "list",
					"placement": "bottom"
				},
				"tooltip": {
					"mode": "multi",
					"sort": "desc"
				}
			}
		},
		{
			"id": 11,
			"type": "timeseries",
			"title": "Batches per minute",
			"description": "Batches each batch poster posted to its parent chain in the last minute. It follows transaction load; zero while the chain is idle.",
			"datasource": {
				"type": "prometheus",
				"uid": "prometheus"
			},
			"gridPos": {
				"x": 12,
				"y": 14,
				"w": 12,
				"h": 8
			},
			"targets": [
				{
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"refId": "A",
					"expr": "increase(litro_rollup_batches[1m])",
					"legendFormat": "{{chain}} → {{parent}}"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "short",
					"min": 0,
					"custom": {
						"lineWidth": 2,
						"fillOpacity": 10,
						"stacking": {
							"mode": "none"
						},
						"showPoints": "never"
					}
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"displayMode": "list",
					"placement": "bottom"
				},
				"tooltip": {
					"mode": "multi",
					"sort": "desc"
				}
			}
		},
		{
			"id": 12,
			"type": "row",
			"title": "Deposits, batches and withdrawals (child → parent)",
			"collapsed": false,
			"gridPos": {
				"x": 0,
				"y": 22,
				"w": 24,
				"h": 1
			},
			"panels": []
		},
		{
			"id": 13,
			"type": "stat",
			"title": "Deposits waiting",
			"description": "Deposits, retryables and force-included transactions in the delayed inbox that no posted batch has read yet. Batch posting reports are left out.",
			"datasource": {
				"type": "prometheus",
				"uid": "prometheus"
			},
			"gridPos": {
				"x": 0,
				"y": 23,
				"w": 6,
				"h": 4
			},
			"targets": [
				{
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"refId": "A",
					"expr": "litro_rollup_delayed_waiting",
					"legendFormat": "{{chain}}"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "short"
				},
				"overrides": []
			},
			"options": {
				"reduceOptions": {
					"calcs": [
						"lastNotNull"
					],
					"values": false
				},
				"textMode": "value_and_name",
				"colorMode": "none",
				"graphMode": "none"
			}
		},
		{
			"id": 14,
			"type": "timeseries",
			"title": "Oldest waiting deposit",
			"description": "How long the oldest of those messages has waited. Empty when nothing waits; a value that keeps climbing means deposits are not reaching the chain.",
			"datasource": {
				"type": "prometheus",
				"uid": "prometheus"
			},
			"gridPos": {
				"x": 6,
				"y": 23,
				"w": 18,
				"h": 8
			},
			"targets": [
				{
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"refId": "A",
					"expr": "time() - litro_rollup_oldest_delayed_waiting_timestamp_seconds",
					"legendFormat": "{{chain}}"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "s",
					"min": 0,
					"decimals": 0,
					"custom": {
						"lineWidth": 2,
						"fillOpacity": 10,
						"stacking": {
							"mode": "none"
						},
						"showPoints": "never"
					}
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"displayMode": "list",
					"placement": "bottom"
				},
				"tooltip": {
					"mode": "multi",
					"sort": "desc"
				}
			}
		},
		{
			"id": 15,
			"type": "timeseries",
			"title": "Time since last batch",
			"description": "Seconds since each chain's transactions were last posted to its parent. While transactions are being sent, a value that keeps climbing means batches are not reaching the parent; it climbs whenever the chain is idle.",
			"datasource": {
				"type": "prometheus",
				"uid": "prometheus"
			},
			"gridPos": {
				"x": 0,
				"y": 31,
				"w": 12,
				"h": 8
			},
			"targets": [
				{
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"refId": "A",
					"expr": "time() - litro_rollup_last_batch_timestamp_seconds",
					"legendFormat": "{{chain}} → {{parent}}"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "s",
					"min": 0,
					"decimals": 0,
					"custom": {
						"lineWidth": 2,
						"fillOpacity": 10,
						"stacking": {
							"mode": "none"
						},
						"showPoints": "never"
					}
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"displayMode": "list",
					"placement": "bottom"
				},
				"tooltip": {
					"mode": "multi",
					"sort": "desc"
				}
			}
		},
		{
			"id": 16,
			"type": "timeseries",
			"title": "Deposits and retryables per minute",
			"description": "User messages delivered to each delayed inbox in the last minute, by kind: eth_deposit, retryable, l2_message (force-included). Only kinds that occurred are shown.",
			"datasource": {
				"type": "prometheus",
				"uid": "prometheus"
			},
			"gridPos": {
				"x": 12,
				"y": 31,
				"w": 12,
				"h": 8
			},
			"targets": [
				{
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"refId": "A",
					"expr": "(increase(litro_rollup_delayed_messages_total{kind!~\"batch_posting_report|initialize\"}[1m])) > 0",
					"legendFormat": "{{chain}} {{kind}}"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "short",
					"min": 0,
					"custom": {
						"lineWidth": 2,
						"fillOpacity": 10,
						"stacking": {
							"mode": "none"
						},
						"showPoints": "never"
					}
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"displayMode": "list",
					"placement": "bottom"
				},
				"tooltip": {
					"mode": "multi",
					"sort": "desc"
				}
			}
		},
		{
			"id": 17,
			"type": "stat",
			"title": "Time since last assertion",
			"description": "Seconds since the validator last created, and last confirmed, an assertion of this chain's state on the parent chain. A withdrawal can be claimed once an assertion covering it is confirmed.",
			"datasource": {
				"type": "prometheus",
				"uid": "prometheus"
			},
			"gridPos": {
				"x": 0,
				"y": 39,
				"w": 24,
				"h": 4
			},
			"targets": [
				{
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"refId": "A",
					"expr": "time() - litro_rollup_last_assertion_created_timestamp_seconds",
					"legendFormat": "{{chain}} created"
				},
				{
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"refId": "B",
					"expr": "time() - litro_rollup_last_assertion_confirmed_timestamp_seconds",
					"legendFormat": "{{chain}} confirmed"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "s",
					"decimals": 0
				},
				"overrides": []
			},
			"options": {
				"reduceOptions": {
					"calcs": [
						"lastNotNull"
					],
					"values": false
				},
				"textMode": "value_and_name",
				"colorMode": "none",
				"graphMode": "none"
			}
		}
	]
}
