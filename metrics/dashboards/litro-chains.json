		{
			"id": 14,
			"type": "timeseries",
			"title": "Time since last batch",
			"description": "Seconds since the batch poster last posted this chain's transactions to its parent chain. While transactions are being sent, a value that keeps climbing means batches are not reaching the parent.",
			"datasource": {
				"type": "prometheus",
				"uid": "prometheus"
			},
			"gridPos": {
				"x": 0,
				"y": 31,
				"w": 12,
				"h": 8
			},
			"targets": [
				{
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"refId": "A",
					"expr": "time() - litro_rollup_last_batch_timestamp_seconds",
					"legendFormat": "{{chain}} → {{parent}}"
				}
