			"targets": [
				{
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"refId": "A",
					"expr": "rate(litro_blocks_total{chain=~\"$chain\"}[30s])",
					"legendFormat": "{{chain}}"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "short",
					"custom": {
						"lineWidth": 2,
