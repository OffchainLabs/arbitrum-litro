		{
			"id": 7,
			"type": "timeseries",
			"title": "Blocks per second",
			"description": "Block production rate. L1 (Anvil) mines one block a second; Nitro chains produce a block whenever there is something to sequence.",
			"datasource": {
				"type": "prometheus",
				"uid": "prometheus"
			},
			"gridPos": {
				"x": 0,
				"y": 6,
				"w": 12,
				"h": 8
