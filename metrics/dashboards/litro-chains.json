{
	"uid": "litro-chains",
	"title": "Litro chains",
	"description": "Every chain the testnode runs, L1 to L3: block production, load, fees, and the rollup pipeline between each chain and its parent.",
	"tags": [
		"litro",
		"chains"
	],
	"timezone": "browser",
	"editable": true,
	"graphTooltip": 1,
	"refresh": "5s",
	"time": {
		"from": "now-15m",
		"to": "now"
	},
	"schemaVersion": 39,
	"version": 1,
	"templating": {
		"list": [
			{
				"name": "chain",
				"label": "chain",
				"type": "query",
				"datasource": {
					"type": "prometheus",
					"uid": "prometheus"
				},
				"query": {
					"query": "label_values(eth_exe_block_most_recent_number, chain)",
					"refId": "variable"
				},
				"definition": "label_values(eth_exe_block_most_recent_number, chain)",
				"refresh": 2,
				"sort": 1,
				"multi": true,
				"includeAll": true,
				"current": {
					"text": "All",
					"value": "$__all"
				}
			}
		]
	},
	"annotations": {
		"list": []
	},
	"panels": [
		{
			"id": 1,
			"type": "row",
			"title": "Is it running?",
			"collapsed": false,
			"gridPos": {
				"x": 0,
				"y": 0,
				"w": 24,
				"h": 1
			},
			"panels": []
		},
		{
			"id": 2,
			"type": "stat",
			"title": "RPC up",
			"description": "Whether each chain's RPC answered the exporter's last poll (1 = up).",
			"datasource": {
				"type": "prometheus",
				"uid": "prometheus"
			},
			"gridPos": {
				"x": 0,
				"y": 1,
				"w": 6,
				"h": 4
			},
			"targets": [
				{
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"refId": "A",
					"expr": "litro_rpc_up{chain=~\"$chain\"}",
					"legendFormat": "{{chain}}"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "short"
				},
				"overrides": []
			},
			"options": {
				"reduceOptions": {
					"calcs": [
						"lastNotNull"
					],
					"values": false
				},
				"textMode": "value_and_name",
				"colorMode": "none",
				"graphMode": "none"
			}
		},
		{
			"id": 3,
			"type": "stat",
			"title": "Head block",
			"description": "Latest block number per chain.",
			"datasource": {
				"type": "prometheus",
				"uid": "prometheus"
			},
			"gridPos": {
				"x": 6,
				"y": 1,
				"w": 6,
				"h": 4
			},
			"targets": [
				{
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"refId": "A",
					"expr": "eth_exe_block_most_recent_number{chain=~\"$chain\"}",
					"legendFormat": "{{chain}}"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "short"
				},
				"overrides": []
			},
			"options": {
				"reduceOptions": {
					"calcs": [
						"lastNotNull"
					],
					"values": false
				},
				"textMode": "value_and_name",
				"colorMode": "none",
				"graphMode": "none"
			}
		},
		{
			"id": 4,
			"type": "stat",
			"title": "Head block age",
			"description": "Seconds since each chain's head block was produced. L1 mines a block every second, so a climbing L1 value means it has stopped. Nitro chains produce blocks only when there are transactions, so their age climbs whenever the chain is idle.",
			"datasource": {
				"type": "prometheus",
				"uid": "prometheus"
			},
			"gridPos": {
				"x": 12,
				"y": 1,
				"w": 6,
				"h": 4
			},
			"targets": [
				{
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"refId": "A",
					"expr": "time() - litro_block_timestamp_seconds{chain=~\"$chain\"}",
					"legendFormat": "{{chain}}"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "s",
					"decimals": 1
				},
				"overrides": []
			},
			"options": {
				"reduceOptions": {
					"calcs": [
						"lastNotNull"
					],
					"values": false
				},
				"textMode": "value_and_name",
				"colorMode": "none",
				"graphMode": "none"
			}
		},
